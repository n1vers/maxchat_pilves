PORT=3000

# Нужен, только если клиент задеплоен ОТДЕЛЬНЫМ сервисом/доменом (CORS).
# Если деплоите одним web-сервисом (сервер отдаёт client/dist) — не указывайте.
# CLIENT_ORIGIN=https://your-client.onrender.com

# Firebase Admin (Project settings -> Service accounts -> Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Redis (Render Key Value / Upstash / любой Redis)
REDIS_URL=redis://default:password@host:port
